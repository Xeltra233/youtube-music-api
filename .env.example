# ytmusic-bridge 配置示例
# 复制为 .env 后修改。环境变量优先级高于本文件。

# HTTP
# 本机开发：127.0.0.1
# 容器/公网：0.0.0.0（Dockerfile 默认已是 0.0.0.0）
HOST=127.0.0.1
PORT=8787
# PORT 必须是纯数字（例如 8787）。
# 不要写成 ${WEB_PORT} 这种未展开模板；若平台只提供 WEB_PORT，可只配 WEB_PORT，或把 PORT 设成真实数字。
# API_KEY=   # 空=不鉴权；非空时要求请求头 X-API-Key
# 公网务必设置 API_KEY

# Admin 上传面板（独立登录页 /admin/login.html）
# 为空则关闭管理端；公网务必设强密码
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# ADMIN_SESSION_TTL_SECONDS=43200

# Search
DEFAULT_LIMIT=10
MAX_LIMIT=20
MIN_SCORE=0.0

# Download / external tools
DOWNLOAD_DIR=downloads
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192
# Prefer project-local tools under bin/ (do not point at external tool directories).
# FFMPEG_LOCATION=bin
# YTDLP_PATH=bin\yt-dlp.exe
# PROXY=
# COOKIES_FILE=
# 云容器挂载文件夹（不要挂单文件）：
# COOKIES_DIR=/app/cookies
# 把任意 Netscape 导出的 .txt 丢进该目录即可（自动提升为 youtube.txt）
# COOKIES_KEEPALIVE=1
# COOKIES_KEEPALIVE_INTERVAL_SECONDS=21600
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILESIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=300

# Lifecycle
SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=86400
CACHE_MAX_TOTAL_MB=2048
CLEANUP_INTERVAL_SECONDS=300
SEARCH_TIMEOUT_SECONDS=15
