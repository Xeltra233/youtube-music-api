# ytmusic-bridge 配置示例
# 复制为 .env 后修改。环境变量优先级高于本文件。

# HTTP
# 本机开发：127.0.0.1
# 容器/公网：0.0.0.0（Dockerfile 默认已是 0.0.0.0）
HOST=127.0.0.1
PORT=8787
# PORT 必须是纯数字（例如 8787）。
# 不要写成 ${WEB_PORT} 这种未展开模板；若平台只提供 WEB_PORT，可只配 WEB_PORT，或把 PORT 设成真实数字。
# API_KEY=   # 空=不鉴权；非空时要求请求头 X-API-Key
# 公网务必设置 API_KEY

# Admin 管理端（/admin/login.html）：YouTube 登录 + Cookie 状态 + 文件上传
# 为空则关闭管理端；公网务必设强密码
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# ADMIN_SESSION_TTL_SECONDS=43200

# Search
DEFAULT_LIMIT=10
MAX_LIMIT=20
MIN_SCORE=0.0

# Download / external tools
DOWNLOAD_DIR=downloads
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192
# Prefer project-local tools under bin/ (do not point at external tool directories).
# FFMPEG_LOCATION=bin
# YTDLP_PATH=bin\yt-dlp.exe
# PROXY=
# COOKIES_FILE=
# 云容器挂载文件夹（不要挂单文件）：
# COOKIES_DIR=/app/cookies
# 把任意 Netscape 导出的 .txt 丢进该目录即可（自动提升为 youtube.txt）
#
# Cookie 来源模式（三条独立可选路线，不是串行前置）：
#   auto     = 默认；已登录的 managed 优先，其次外部浏览器 profile，最后文件
#   managed  = 仅使用服务端专用浏览器登录（管理前端）
#   external = 仅使用 COOKIES_FROM_BROWSER 读取已登录外部 profile
#   file     = 仅使用上传/目录 drop-in 的 Netscape 文件
# COOKIE_SOURCE_MODE=auto
#
# 外部浏览器 profile（可选独立路线；与前端登录互不前置）
# 作为单个 argv 传给 yt-dlp，不要拆 shell：
#   chrome
#   chrome:Default
#   edge:C:\Users\you\AppData\Local\Microsoft\Edge\User Data\Default
#   firefox:Profile With Spaces
# COOKIES_FROM_BROWSER=
# COOKIES_BROWSER_SYNC_ON_START=true
# 周期同步间隔秒数；0=关闭周期同步（启动同步仍由 ON_START 决定）；正数下限 60
# COOKIES_BROWSER_SYNC_INTERVAL_SECONDS=21600
#
# 服务端专用 YouTube 登录 profile（管理前端推荐主路线）
# Windows 本机可留空 browser path，服务会自动探测本机 Chromium/Chrome/Edge
# 容器镜像默认已设置 chromium 与可写 profile 目录
# YOUTUBE_LOGIN_BROWSER_PATH=
# YOUTUBE_LOGIN_PROFILE_DIR=browser-profile
# YOUTUBE_LOGIN_HEADLESS=true
# 交互登录会话空闲 TTL（秒），夹紧到 60~1800
# YOUTUBE_LOGIN_SESSION_TTL_SECONDS=900
# managed profile 后台刷新间隔（秒）；0=关闭；正数下限 60
# YOUTUBE_LOGIN_REFRESH_INTERVAL_SECONDS=21600
#
# COOKIES_KEEPALIVE=1
# COOKIES_KEEPALIVE_INTERVAL_SECONDS=21600
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILESIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=300

# Lifecycle
SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=86400
CACHE_MAX_TOTAL_MB=2048
CLEANUP_INTERVAL_SECONDS=300
SEARCH_TIMEOUT_SECONDS=15
