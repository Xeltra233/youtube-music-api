# ytmusic-bridge configuration example
# Copy to .env and edit. Env vars override this file.

# HTTP
HOST=127.0.0.1
PORT=8787
# API_KEY=   # empty = no auth; non-empty requires X-API-Key header

# Search
DEFAULT_LIMIT=10
MAX_LIMIT=20
MIN_SCORE=0.0

# Download / external tools
DOWNLOAD_DIR=downloads
AUDIO_FORMAT=mp3
AUDIO_BITRATE=192
# Prefer project-local tools under bin/ (do not point at external tool directories).
# FFMPEG_LOCATION=bin
# YTDLP_PATH=bin\yt-dlp.exe
# PROXY=
# COOKIES_FILE=
MAX_CONCURRENT_DOWNLOADS=2
MAX_FILESIZE_MB=50
DOWNLOAD_TIMEOUT_SECONDS=300

# Lifecycle
SESSION_TTL_SECONDS=1800
CACHE_TTL_SECONDS=86400
CACHE_MAX_TOTAL_MB=2048
CLEANUP_INTERVAL_SECONDS=300
SEARCH_TIMEOUT_SECONDS=15
